python -m vajra.entrypoints.openai.api_server \
--model_config_model {{ model.identifier }} \
--model_config_dtype float16 \
--request_prioritizer_config_type {{ server.request_prioratizer_type | upper }} \
--scheduler_config_type {{ server.scheduler_type }} \
--parallel_config_tensor_parallel_size {{ parallel_spec.tp_dimension }} \
--parallel_config_pipeline_parallel_size {{ parallel_spec.pp_dimension }} \
--fixed_chunk_replica_scheduler_config_chunk_size {{ server.fixed_chunk_size }} \
--dynamic_chunk_replica_scheduler_config_min_chunk_size_param {{ server.min_chunk_size }} \
--dynamic_chunk_replica_scheduler_config_max_chunk_size_param {{ server.max_chunk_size }} \
--space_sharing_replica_scheduler_config_max_chunk_size_param {{ server.max_chunk_size }} \
--space_sharing_replica_scheduler_config_min_chunk_size_param {{ server.min_chunk_size }} \
--chat_template "{{ model.chat_template }}" \
--port {{ port }} \
--host 127.0.0.1 \
--log_level error