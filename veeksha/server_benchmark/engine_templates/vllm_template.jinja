python -m vllm.entrypoints.openai.api_server \
--model {{ model.identifier }} \
--dtype auto \
--api-key {{ server.openai_api_key }} \
-tp {{ parallel_spec.tp_dimension }} \
-pp {{ parallel_spec.pp_dimension }} \
--scheduling-policy {{ server.schedule_policy | upper }} \
--chat-template "{{ model.chat_template }}" \
--max-num-batched-tokens {{ server.fixed_chunk_size }} \
--port {{ port }} \
--enable-chunked-prefill true \
--max-num-seqs 256 \
--uvicorn-log-level error \
--disable-log-stats \
--disable-log-requests