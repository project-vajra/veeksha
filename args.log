options:
  -h, --help            show this help message and exit
  --benchmark-config-from-file BENCHMARK_CONFIG_FROM_FILE
                        Path to YAML/JSON configuration file for
                        BenchmarkConfig. (default: None)
  --seed SEED           Seed for the random number generator. (default: 42)
  --timeout TIMEOUT     The amount of time to run the load test for. (default:
                        1200)
  --max-completed-requests MAX_COMPLETED_REQUESTS
                        The number of requests to complete before finishing
                        the test. Note that its possible for the test to
                        timeout first. (default: 10)
  --api-url API_URL     The API URL for the benchmark. (default:
                        http://localhost:8000/v1)
  --api-key API_KEY     The API key for the benchmark. (default: token-abc123)
  --client-config-from-file CLIENT_CONFIG_FROM_FILE
                        Path to YAML/JSON configuration file for ClientConfig.
                        (default: None)
  --client-config-model CLIENT_CONFIG_MODEL
                        The model to use for this load test. (default: meta-
                        llama/Meta-Llama-3-8B-Instruct)
  --client-config-tokenizer CLIENT_CONFIG_TOKENIZER
                        The tokenizer to use for this load test. By default,
                        the tokenizer is inferred from the model. (default:
                        None)
  --client-config-num-clients CLIENT_CONFIG_NUM_CLIENTS
                        The default number of clients to use for benchmark.
                        (default: 2)
  --client-config-num-concurrent-requests-per-client CLIENT_CONFIG_NUM_CONCURRENT_REQUESTS_PER_CLIENT
                        The number of concurrent requests each client can
                        manage. (default: 5)
  --client-config-auto-spawn-new-clients, --no-client-config-auto-spawn-new-clients
                        If True, spawn additional clients when requests are
                        ready to be dispatched but all clients are busy.
                        Spawned clients use the same per-client concurrency.
                        (default: False)
  --client-config-max-clients CLIENT_CONFIG_MAX_CLIENTS
                        Maximum total number of clients allowed when auto-
                        spawn is enabled. None means unlimited. (default:
                        None)
  --client-config-additional-sampling-params CLIENT_CONFIG_ADDITIONAL_SAMPLING_PARAMS
                        Additional sampling params to send with the each
                        request to the LLM API. By default, no additional
                        sampling params are sent. (default: {})
  --client-config-llm-api CLIENT_CONFIG_LLM_API
                        The name of the llm api to use. Can select from
                        ['openai_chat', 'openai_completions'] (default:
                        openai_chat)
  --client-config-address-append-value CLIENT_CONFIG_ADDRESS_APPEND_VALUE
                        The address append value for OpenAI API. (default:
                        chat/completions)
  --client-config-request-timeout CLIENT_CONFIG_REQUEST_TIMEOUT
                        The timeout for each request to the LLM API (in
                        seconds). (default: 60)
  --client-config-min-tokens-param CLIENT_CONFIG_MIN_TOKENS_PARAM
                        Name of server parameter for minimum tokens to be
                        generated. If omitted or non accepted by the server,
                        fallback to prompt-based minimum token request (append
                        instruction to prompt to generate at least the
                        requested number of tokens). (default: min_tokens)
  --metrics-config-from-file METRICS_CONFIG_FROM_FILE
                        Path to YAML/JSON configuration file for
                        MetricsConfig. (default: None)
  --metrics-config-output-dir METRICS_CONFIG_OUTPUT_DIR
                        The directory to save the benchmark results to.
                        (default: benchmark_results)
  --metrics-config-deadline-report-from-file METRICS_CONFIG_DEADLINE_REPORT_FROM_FILE
                        Path to YAML/JSON configuration file for
                        DeadlineReportConfig. (default: None)
  --metrics-config-deadline-report-ttft-deadline METRICS_CONFIG_DEADLINE_REPORT_TTFT_DEADLINE
                        The deadline, in seconds, for time to first token.
                        (default: 0.1)
  --metrics-config-deadline-report-tbt-deadline METRICS_CONFIG_DEADLINE_REPORT_TBT_DEADLINE
                        The deadline, in seconds, for time between tokens.
                        (default: 0.05)
  --metrics-config-deadline-report-target-deadline-miss-rate METRICS_CONFIG_DEADLINE_REPORT_TARGET_DEADLINE_MISS_RATE
                        The target deadline miss rate [0,1]. Used to report
                        smallest TBT deadline that would meet it. (default:
                        0.1)
  --metrics-config-should-write-metrics-to-wandb, --no-metrics-config-should-write-metrics-to-wandb
                        Whether to write metrics to wandb. (default: False)
  --metrics-config-wandb-project METRICS_CONFIG_WANDB_PROJECT
                        The wandb project to log metrics to. (default: None)
  --metrics-config-wandb-group METRICS_CONFIG_WANDB_GROUP
                        The wandb group to log metrics to. (default: None)
  --metrics-config-wandb-run-name METRICS_CONFIG_WANDB_RUN_NAME
                        The wandb run name to log metrics to. (default: None)
  --metrics-config-enable-wandb-sweep, --no-metrics-config-enable-wandb-sweep
                        Whether to enable wandb sweep. (default: False)
  --metrics-config-wandb-sweep-id METRICS_CONFIG_WANDB_SWEEP_ID
                        The wandb sweep id to log metrics to. (default: None)
  --metrics-config-wandb-sweep-name METRICS_CONFIG_WANDB_SWEEP_NAME
                        The wandb sweep name to log metrics to. (default:
                        None)
  --request-generator-config-type REQUEST_GENERATOR_CONFIG_TYPE
                        The request generator configuration for the benchmark.
                        (default: synthetic)
  --request-generator-config-from-file REQUEST_GENERATOR_CONFIG_FROM_FILE
                        Path to YAML/JSON configuration file for
                        BaseRequestGeneratorConfig. (default: None)
  --lmeval-request-generator-config-max-tokens LMEVAL_REQUEST_GENERATOR_CONFIG_MAX_TOKENS
                        Maximum number of tokens allowed. (default: 8192)
  --lmeval-request-generator-config-tasks LMEVAL_REQUEST_GENERATOR_CONFIG_TASKS [LMEVAL_REQUEST_GENERATOR_CONFIG_TASKS ...]
                        The tasks to evaluate the language model on. (default:
                        ['hellaswag'])
  --lmeval-request-generator-config-num-fewshot LMEVAL_REQUEST_GENERATOR_CONFIG_NUM_FEWSHOT
                        The number of fewshot examples to use for the tasks.
                        (default: 1)
  --lmeval-request-generator-config-limit LMEVAL_REQUEST_GENERATOR_CONFIG_LIMIT
                        The number of examples to evaluate on. (default: 10)
  --lmeval-request-generator-config-interval-generator-config-type LMEVAL_REQUEST_GENERATOR_CONFIG_INTERVAL_GENERATOR_CONFIG_TYPE
  --lmeval-request-generator-config-gamma-interval-generator-config-qps LMEVAL_REQUEST_GENERATOR_CONFIG_GAMMA_INTERVAL_GENERATOR_CONFIG_QPS
                        Queries per second for the Gamma distribution.
                        (default: 1.0)
  --lmeval-request-generator-config-gamma-interval-generator-config-cv LMEVAL_REQUEST_GENERATOR_CONFIG_GAMMA_INTERVAL_GENERATOR_CONFIG_CV
                        Coefficient of variation for the Gamma distribution.
                        (default: 0.5)
  --lmeval-request-generator-config-poisson-interval-generator-config-qps LMEVAL_REQUEST_GENERATOR_CONFIG_POISSON_INTERVAL_GENERATOR_CONFIG_QPS
                        Queries per second for the Poisson distribution.
                        (default: 1.0)
  --lmeval-request-generator-config-trace-interval-generator-config-exhaustion-policy LMEVAL_REQUEST_GENERATOR_CONFIG_TRACE_INTERVAL_GENERATOR_CONFIG_EXHAUSTION_POLICY
                        Behavior when the trace runs out: error | stop | wrap.
                        (default: stop)
  --lmeval-request-generator-config-trace-interval-generator-config-trace-file LMEVAL_REQUEST_GENERATOR_CONFIG_TRACE_INTERVAL_GENERATOR_CONFIG_TRACE_FILE
                        Path to the trace file for request intervals. Should
                        be a csv or jsonl file. (default: /coc/scratch/docker_
                        safe/amey/revati-
                        v2/external/veeksha/veeksha/data/processed_traces/swe_
                        agent_trace_short.jsonl)
  --lmeval-request-generator-config-trace-interval-generator-config-timestamp-column LMEVAL_REQUEST_GENERATOR_CONFIG_TRACE_INTERVAL_GENERATOR_CONFIG_TIMESTAMP_COLUMN
                        Name of the column containing request timestamps.
                        (default: timestamp)
  --lmeval-request-generator-config-trace-interval-generator-config-timestamp-unit LMEVAL_REQUEST_GENERATOR_CONFIG_TRACE_INTERVAL_GENERATOR_CONFIG_TIMESTAMP_UNIT
                        Unit of the timestamps in the trace file. Must be in
                        ['ms', 's']. (default: ms)
  --lmeval-request-generator-config-trace-interval-generator-config-time-scale-factor LMEVAL_REQUEST_GENERATOR_CONFIG_TRACE_INTERVAL_GENERATOR_CONFIG_TIME_SCALE_FACTOR
                        Factor to scale the dispatch intervals in the trace.
                        (default: 1)
  --synthetic-request-generator-config-max-tokens SYNTHETIC_REQUEST_GENERATOR_CONFIG_MAX_TOKENS
                        Maximum number of tokens allowed. (default: 8192)
  --synthetic-request-generator-config-length-generator-config-type SYNTHETIC_REQUEST_GENERATOR_CONFIG_LENGTH_GENERATOR_CONFIG_TYPE
  --synthetic-request-generator-config-fixed-length-generator-config-max-tokens SYNTHETIC_REQUEST_GENERATOR_CONFIG_FIXED_LENGTH_GENERATOR_CONFIG_MAX_TOKENS
                        Maximum number of tokens allowed in a request.
                        (default: 4096)
  --synthetic-request-generator-config-fixed-length-generator-config-prefill-tokens SYNTHETIC_REQUEST_GENERATOR_CONFIG_FIXED_LENGTH_GENERATOR_CONFIG_PREFILL_TOKENS
                        Number of prefill tokens. (default: 4096)
  --synthetic-request-generator-config-fixed-length-generator-config-decode-tokens SYNTHETIC_REQUEST_GENERATOR_CONFIG_FIXED_LENGTH_GENERATOR_CONFIG_DECODE_TOKENS
                        Number of decode tokens. (default: 512)
  --synthetic-request-generator-config-trace-length-generator-config-max-tokens SYNTHETIC_REQUEST_GENERATOR_CONFIG_TRACE_LENGTH_GENERATOR_CONFIG_MAX_TOKENS
                        Maximum number of tokens allowed in a request.
                        (default: 4096)
  --synthetic-request-generator-config-trace-length-generator-config-exhaustion-policy SYNTHETIC_REQUEST_GENERATOR_CONFIG_TRACE_LENGTH_GENERATOR_CONFIG_EXHAUSTION_POLICY
                        Behavior when the trace runs out: error | stop | wrap.
                        (default: stop)
  --synthetic-request-generator-config-trace-length-generator-config-trace-file SYNTHETIC_REQUEST_GENERATOR_CONFIG_TRACE_LENGTH_GENERATOR_CONFIG_TRACE_FILE
                        Path to the trace file for request lengths. (default: 
                        /coc/scratch/docker_safe/amey/revati-
                        v2/external/veeksha/veeksha/data/processed_traces/shar
                        egpt_8k_filtered_stats_llama2_tokenizer.csv)
  --synthetic-request-generator-config-trace-length-generator-config-input-length-column SYNTHETIC_REQUEST_GENERATOR_CONFIG_TRACE_LENGTH_GENERATOR_CONFIG_INPUT_LENGTH_COLUMN
                        Name of the column containing the input (prefill)
                        length. (default: num_prefill_tokens)
