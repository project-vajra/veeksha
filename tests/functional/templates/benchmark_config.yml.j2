timeout: {{ timeout }}
max_completed_requests: {{ max_completed_requests }}
api_url: {{ api_url }}
{% if api_key %}api_key: {{ api_key }}{% endif %}

client_config:
  model: {{ model }}
  num_clients: {{ num_clients }}
  num_concurrent_requests_per_client: {{ num_concurrent_requests_per_client }}
  llm_api: openai_chat

request_generator_config:
  type: {{ request_generator_type }}
  {% if request_generator_type == "synthetic" %}
  {% if length_generator_type %}
  length_generator_config:
    type: {{ length_generator_type }}
    {% if length_generator_type == "fixed" %}
    prefill_tokens: {{ prefill_tokens }}
    decode_tokens: {{ decode_tokens }}
    {% elif length_generator_type == "uniform" %}
    min_tokens: {{ min_tokens }}
    max_tokens: {{ max_tokens }}
    prefill_to_decode_ratio: {{ prefill_to_decode_ratio | default(0.5) }}
    {% elif length_generator_type == "zipf" %}
    min_tokens: {{ min_tokens }}
    max_tokens: {{ max_tokens }}
    theta: {{ theta | default(1.0) }}
    scramble: {{ scramble | default(true) }}
    prefill_to_decode_ratio: {{ prefill_to_decode_ratio | default(0.5) }}
    {% elif length_generator_type == "trace" %}
    trace_file: {{ trace_file }}
    max_tokens: {{ max_tokens }}
    {% endif %}
  {% endif %}
  {% if interval_generator_type %}
  interval_generator_config:
    type: {{ interval_generator_type }}
    {% if interval_generator_type == "poisson" %}
    qps: {{ qps }}
    {% elif interval_generator_type == "gamma" %}
    qps: {{ qps }}
    cv: {{ cv }}
    {% elif interval_generator_type == "static" %}
    duration: {{ duration }}
    {% endif %}
  {% endif %}
  {% elif request_generator_type == "trace" %}
  {% if trace_file %}
  trace_file: {{ trace_file }}
  {% endif %}
  {% if max_tokens is not none %}
  max_tokens: {{ max_tokens }}
  {% endif %}
  {% if trace_input_length_column %}
  input_length_column: {{ trace_input_length_column }}
  {% endif %}
  {% if trace_output_length_column %}
  output_length_column: {{ trace_output_length_column }}
  {% endif %}
  {% if trace_block_size is not none %}
  block_size: {{ trace_block_size }}
  {% endif %}
  {% if trace_timestamp_column %}
  timestamp_column: {{ trace_timestamp_column }}
  {% endif %}
  {% if trace_timestamp_unit %}
  timestamp_unit: {{ trace_timestamp_unit }}
  {% endif %}
  {% if trace_time_scale_factor is not none %}
  time_scale_factor: {{ trace_time_scale_factor }}
  {% endif %}
  {% if trace_use_prefix_hash_ids is not none %}
  use_trace_prefix_hash_ids: {{ trace_use_prefix_hash_ids }}
  {% endif %}
  {% if trace_remap_hash_ids is not none %}
  remap_hash_ids: {{ trace_remap_hash_ids }}
  {% endif %}
  {% if trace_use_sessions is not none %}
  use_trace_sessions: {{ trace_use_sessions }}
  {% endif %}
  {% if session_generator_config %}
  session_generator_config:
    {% if session_generator_config.seed is defined %}seed: {{ session_generator_config.seed }}{% endif %}
    {% if session_generator_config.minimum_prefix_match is defined %}minimum_prefix_match: {{ session_generator_config.minimum_prefix_match }}{% endif %}
    {% if session_generator_config.min_session_size is defined %}min_session_size: {{ session_generator_config.min_session_size }}{% endif %}
    {% if session_generator_config.max_session_size is defined %}max_session_size: {{ session_generator_config.max_session_size }}{% endif %}
    {% if session_generator_config.max_request_interval is defined %}max_request_interval: {{ session_generator_config.max_request_interval }}{% endif %}
    {% if session_generator_config.save_as_trace_file is defined %}save_as_trace_file: {{ session_generator_config.save_as_trace_file }}{% endif %}
    {% if session_generator_config.trace_file_save_dir is defined %}trace_file_save_dir: {{ session_generator_config.trace_file_save_dir }}{% endif %}
    {% if session_generator_config.trace_file_name is defined %}trace_file_name: {{ session_generator_config.trace_file_name }}{% endif %}
    {% if session_generator_config.session_interval_generator_config is defined %}
    session_interval_generator_config:
      type: {{ session_generator_config.session_interval_generator_config.type }}
      {% if session_generator_config.session_interval_generator_config.type == "poisson" %}
      {% if session_generator_config.session_interval_generator_config.qps is defined %}qps: {{ session_generator_config.session_interval_generator_config.qps }}{% endif %}
      {% elif session_generator_config.session_interval_generator_config.type == "gamma" %}
      {% if session_generator_config.session_interval_generator_config.qps is defined %}qps: {{ session_generator_config.session_interval_generator_config.qps }}{% endif %}
      {% if session_generator_config.session_interval_generator_config.cv is defined %}cv: {{ session_generator_config.session_interval_generator_config.cv }}{% endif %}
      {% elif session_generator_config.session_interval_generator_config.type == "static" %}
      {% if session_generator_config.session_interval_generator_config.duration is defined %}duration: {{ session_generator_config.session_interval_generator_config.duration }}{% endif %}
      {% endif %}
    {% endif %}
  {% endif %}
  {% elif request_generator_type == "lmeval" %}
  tasks:
  {% for t in lmeval_tasks %}
    - {{ t }}
  {% endfor %}
  num_fewshot: {{ lmeval_num_fewshot }}
  limit: {{ lmeval_limit }}
  {% if interval_generator_type %}
  interval_generator_config:
    type: {{ interval_generator_type }}
    {% if interval_generator_type == "poisson" %}
    qps: {{ qps }}
    {% elif interval_generator_type == "gamma" %}
    qps: {{ qps }}
    cv: {{ cv }}
    {% elif interval_generator_type == "static" %}
    duration: {{ duration }}
    {% endif %}
  {% endif %}
  {% endif %}

metrics_config:
  output_dir: {{ output_dir }}
  {% if ttft_deadline %}
  deadline_report:
    ttft_deadline: {{ ttft_deadline }}
    {% if tbt_deadline %}tbt_deadline: {{ tbt_deadline }}{% endif %}
  {% endif %}
