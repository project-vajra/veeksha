output_dir: {{ output_dir }}
max_iterations: {{ max_iterations }}

slos:
{% for slo in slos %}
  - type: {{ slo.type }}
    metric: {{ slo.metric }}
    value: {{ slo.value }}
    percentile: {{ slo.percentile }}
    name: {{ slo.name }}
{% endfor %}

benchmark_config:
  timeout: {{ timeout }}
  max_completed_requests: {{ max_completed_requests }}
  api_url: {{ api_url }}
  {% if api_key %}api_key: {{ api_key }}{% endif %}

  client_config:
    model: {{ model }}
    num_clients: {{ num_clients }}
    num_concurrent_requests_per_client: {{ num_concurrent_requests_per_client }}
    llm_api: openai_chat

  request_generator_config:
    type: {{ request_generator_type }}
    {% if request_generator_type == "synthetic" %}
    synthetic_request_generator:
      {% if prompt_length and output_length %}
      prompt_length: {{ prompt_length }}
      output_length: {{ output_length }}
      {% endif %}
      {% if length_generator_config %}
      length_generator_config: {{ length_generator_config | tojson }}
      {% endif %}
      {% if interval_generator_config %}
      interval_generator_config: {{ interval_generator_config | tojson }}
      {% endif %}
    {% endif %}

  {% if interval_generator_config %}
  request_interval_generator_config:
    type: {{ interval_generator_config.type }}
    {% if interval_generator_config.type == "static" %}
    static_request_interval_generator:
      duration: {{ interval_generator_config.duration }}
    {% endif %}
  {% endif %}